# Copy to .env. Values below are development defaults, not production secrets.
APP_ENV=development
DEBUG=false
AUTH_JWT_SECRET=development-only-change-me
AUTH_JWT_ISSUER=safemeal
AUTH_JWT_AUDIENCE=safemeal-api
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# DashScope/OpenAI-compatible model, embedding and rerank APIs.
ENABLE_LLM=true
ENABLE_EXTERNAL_RECIPE_SEARCH=true
EXTERNAL_RECIPE_ENDPOINT=https://zh.wikibooks.org/w/api.php
EXTERNAL_RECIPE_TIMEOUT=8
REQUEST_UNDERSTANDING_BACKEND=rules
REQUEST_UNDERSTANDING_MODEL_PATH=
REQUEST_UNDERSTANDING_CONFIDENCE_THRESHOLD=0.7
LLM_MODEL=qwen3-max
LLM_API_KEY=sk-02263e9cf73345729fc564ad756092df
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_REQUEST_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_STRUCTURED_REPAIR_RETRIES=1

ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services
RERANK_ENDPOINT=/rerank/text-rerank/text-rerank

# Local services. Docker Compose overrides hosts inside the API container.
DATABASE_URL=mysql+pymysql://recipe_user:safemeal-local@127.0.0.1:13306/recipe_db
DB_CONNECT_TIMEOUT=10
MYSQL_DATABASE=recipe_db
MYSQL_USER=recipe_user
MYSQL_PASSWORD=safemeal-local
MYSQL_ROOT_PASSWORD=safemeal-local-root

REDIS_RATE_LIMIT_URL=redis://127.0.0.1:16379/0
HTTP_RATE_LIMIT_PER_MINUTE=120

ENABLE_MILVUS=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=recipes_current
KB_TOP_K=5
KB_MAX_CHUNKS_PER_DOCUMENT=2
KB_DOCUMENT_RECALL_MULTIPLIER=4

ENABLE_NEO4J=true
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=safemeal-local-neo4j
NEO4J_AUTH=neo4j/safemeal-local-neo4j
NEO4J_DATABASE=neo4j
NEO4J_RECIPE_JSON_PATH=data/recipe.json
NEO4J_INGREDIENT_JSON_PATH=data/neo4j/excipients.json

# Agent execution limits and checkpoints.
AGENT_MAX_CONCURRENCY=8
AGENT_TIMEOUT=300
AGENT_MAX_TOOL_CALLS=12
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_RESPONSE_TOKEN_RESERVE=1200
AGENT_CHECKPOINT_PATH=data/runtime/agent_checkpoints.sqlite3
# Required in production/HA, for example postgresql://user:pass@postgres:5432/safemeal
AGENT_CHECKPOINT_DATABASE_URL=
AGENT_REQUIRE_HUMAN_APPROVAL=true
KB_HYBRID_ENABLED=true
KB_BM25_PATH=data/runtime/knowledge_bm25.sqlite3
KB_RRF_RANK_CONSTANT=60
OCR_ENABLED=true
OCR_LANGUAGES=chi_sim+eng
INGESTION_QUEUE_URL=redis://127.0.0.1:16379/1
INGESTION_QUEUE_NAME=safemeal:ingestion

# Optional external identity provider.
ENABLE_OIDC=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_TENANT_CLAIM=tenant_id
DEFAULT_TENANT_ID=default

# Milvus dependencies used by Docker Compose.
MINIO_ROOT_USER=safemealminio
MINIO_ROOT_PASSWORD=safemeal-local-minio
