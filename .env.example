# SafeMeal Agent development environment
#
# Recommended workflow:
#   1. cp .env.example .env
#   2. Fill in LLM_API_KEY with an Alibaba Cloud DashScope API key.
#   3. Start infrastructure with: docker compose up -d
#   4. Start the API locally with: python -m uvicorn back.main:application --reload
#
# This template uses host ports because the API is assumed to run locally.
# When the API runs in Docker Compose, docker-compose.yml overrides database
# addresses with the corresponding container service names.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=SafeMeal Agent
APP_VERSION=0.1.2
APP_ENV=development
# Compose defaults to production. Use development only for a local-only stack.
APP_ENV_DOCKER=production
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
UPLOAD_DIR=uploads
FILE_UPLOAD_MAX_MB=2
HTTP_MAX_BODY_MB=12
HTTP_RATE_LIMIT_PER_MINUTE=120
REDIS_RATE_LIMIT_URL=
TOOL_RATE_LIMIT_PER_MINUTE=600
MODEL_RATE_LIMIT_PER_MINUTE=120
LLM_MAX_OUTPUT_TOKENS=2048
MODEL_COST_CURRENCY=CNY
# Provider prices change; configure reviewed prices per million tokens.
# Example shape: {"model":{"input_cost_per_million":1,"output_cost_per_million":2}}
MODEL_PRICING_JSON={}
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173,http://127.0.0.1:4173
# Production must use trusted_gateway and a random secret of at least 32 characters.
# The gateway authenticates callers, strips inbound copies of the identity
# headers, then sets X-SafeMeal-User-ID and X-SafeMeal-Roles itself.
AUTH_MODE=disabled
AUTH_GATEWAY_SECRET=
AUTH_MODE_DOCKER=trusted_gateway

# -----------------------------------------------------------------------------
# Feature switches and health probes
# -----------------------------------------------------------------------------
ENABLE_LLM=true
ENABLE_EMBEDDINGS=true
ENABLE_MILVUS=true
ENABLE_NEO4J=true
ENABLE_LIGHTRAG=true
INTEGRATION_PROBE_TIMEOUT=10

# -----------------------------------------------------------------------------
# Alibaba Cloud DashScope
# The project uses the OpenAI-compatible endpoint for chat and embeddings.
# One API key is reused by embeddings and reranking unless their own keys are set.
# -----------------------------------------------------------------------------
LLM_MODEL=qwen3-max
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek is inactive while the placeholder remains. Replace it with a real
# secret to activate verified primary -> deepseekv4-pro failover.
DEEPSEEK_API_KEY=replace-with-real-deepseek-api-key
LLM_FALLBACKS_JSON=[{"name":"deepseekv4-pro","model":"deepseek-v4-pro","base_url":"https://api.deepseek.com/v1","api_key_env":"DEEPSEEK_API_KEY","extra_body":{"thinking":{"type":"disabled"}}}]
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RECOVERY_SECONDS=30

EMBEDDING_MODEL=text-embedding-v4
# Leave empty to reuse LLM_API_KEY and LLM_BASE_URL.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

# DashScope reranking uses its native API rather than compatible-mode/v1.
RERANK_ENABLED=true
RERANK_PROVIDER=custom
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services
RERANK_ENDPOINT=/rerank/text-rerank/text-rerank
RERANK_MODEL=qwen3-rerank
# Leave empty to reuse LLM_API_KEY.
RERANK_API_KEY=
RERANK_MAX_CANDIDATES=20
RERANK_TOP_N=6
RERANK_TIMEOUT=30

# -----------------------------------------------------------------------------
# Databases
# -----------------------------------------------------------------------------
# MySQL container is exposed on host port 13306.
DATABASE_URL=mysql+pymysql://recipe_user:change-me@127.0.0.1:13306/recipe_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# Docker-only bootstrap contract. Replace every change-me value before use.
MYSQL_DATABASE=recipe_db
MYSQL_USER=recipe_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root
DATABASE_URL_DOCKER=mysql+pymysql://recipe_user:change-me@mysql:3306/recipe_db
MYSQL_HOST_PORT=13306
REDIS_HOST_PORT=6379
API_PORT=8000
SAFEMEAL_IMAGE_TAG=local

# Required only when the optional retrieval profile is enabled.
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# Milvus container is exposed on host port 19530.
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_HOST_PORT=19530
MILVUS_HEALTH_HOST_PORT=9091
MILVUS_COLLECTION=recipes_current
MILVUS_LEGACY_COLLECTION=recipes
MILVUS_COLLECTION_TARGET=recipes_v2
MILVUS_INDEX_TYPE=IVF_FLAT
MILVUS_METRIC_TYPE=IP
# 集合加载最长等待时间。Milvus 状态异常时避免 Collection.load 无限轮询。
MILVUS_LOAD_TIMEOUT=30

# Neo4j is the recipe relationship graph. Local legacy volumes may use
# NEO4J_AUTH=none; production must set a username/password pair.
NEO4J_URI=bolt://localhost:17687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_AUTH=none
NEO4J_HTTP_HOST_PORT=17474
NEO4J_BOLT_HOST_PORT=17687
NEO4J_DEFAULT_GRAPH_QUERY=MATCH (a)-[r]-(b) RETURN a, r, b LIMIT 100
NEO4J_GRAPH_CACHE_PATH=data/neo4j/graph.json
NEO4J_CONNECTION_TIMEOUT=10
NEO4J_RECIPE_JSON_PATH=data/recipe.json
NEO4J_INGREDIENT_JSON_PATH=data/neo4j/excipients.json

# LightRAG stores its graph index on disk and uses the configured LLM/embedding provider.
LIGHTRAG_WORKING_DIR=./data/lightrag
LIGHTRAG_RETRIEVAL_MODE=hybrid
LIGHTRAG_TOP_K=10
LIGHTRAG_MAX_TOKEN_SIZE=4096
LIGHTRAG_OPERATION_TIMEOUT=120

# -----------------------------------------------------------------------------
# Agent runtime
# -----------------------------------------------------------------------------
LLM_REQUEST_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_STRUCTURED_REPAIR_RETRIES=1
MAX_ITERATIONS=4
AGENT_TIMEOUT=300
AGENT_TOOL_TIMEOUT=60
AGENT_HISTORY_MESSAGES=12
AGENT_HISTORY_SCAN_MESSAGES=40
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_RESPONSE_TOKEN_RESERVE=1200
AGENT_MEMORY_RETRIEVAL_LIMIT=20
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_MODEL_TOKENS=20000
AGENT_MAX_COST=0
AGENT_MAX_CONCURRENCY=8
AGENT_DISTRIBUTED_MAX_CONCURRENCY=16
AGENT_QUEUE_WAIT_TIMEOUT=15
AGENT_QUEUE_LEASE_SECONDS=330
STREAM_FIRST_PACKET_TIMEOUT=8
STREAM_CHUNK_CHARS=64

# -----------------------------------------------------------------------------
# Online product feedback
# -----------------------------------------------------------------------------
# 线上 Agent 错误与用户负反馈只进入待审核队列，不会自动成为金标数据。
ENABLE_ONLINE_FAILURE_CAPTURE=true
ONLINE_FAILURE_QUEUE_PATH=data/runtime/online_failures.jsonl
ENABLE_AGENT_TRACE_PERSISTENCE=true
AGENT_TRACE_PATH=data/runtime/agent_traces.jsonl
AGENT_TRACE_MAX_BYTES=50000000
AGENT_TRACE_BACKUP_COUNT=5

# -----------------------------------------------------------------------------
# Knowledge retrieval
# -----------------------------------------------------------------------------
KB_TOP_K=5
KB_SIMILARITY_THRESHOLD=0.2
KB_CHUNK_SIZE=512
KB_CHUNK_OVERLAP=80
KB_CHUNK_STRATEGY=auto
KB_SEMANTIC_BREAKPOINT_THRESHOLD=0.55
KB_SEMANTIC_MAX_SEGMENTS=256
KB_DOCUMENT_CHUNK_STRATEGIES_JSON={"pypdf":"semantic","python-docx":"semantic","python-pptx":"semantic","apache-tika":"semantic","html":"recursive","text":"recursive","json":"recursive","csv":"recursive","openpyxl":"recursive"}
KB_RERANK_SCORE_THRESHOLD=0.8

# Apache Tika full image supports legacy office formats and OCR fallback.
TIKA_ENABLED=false
TIKA_URL=http://localhost:9998
TIKA_TIMEOUT=120
TIKA_MAX_EXTRACTED_CHARS=2000000

# Incremental knowledge sources: local://, https://, s3:// or feishu://.
SOURCE_LOCAL_ROOT=uploads
SOURCE_HTTP_ALLOWED_HOSTS=
SOURCE_S3_BUCKET=
SOURCE_S3_PREFIX=
SOURCE_S3_ENDPOINT_URL=
FEISHU_ACCESS_TOKEN=
SOURCE_SYNC_STATE_PATH=data/sync/source_states.json
SOURCE_SYNC_JOBS_JSON=[]
SOURCE_DELETE_MISSING=true
# Monitoring stack. Set an external webhook to forward durable alert inbox events.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=safemeal-local
ALERT_NOTIFICATION_WEBHOOK_URL=
ALERT_NOTIFICATION_WEBHOOK_TOKEN=
