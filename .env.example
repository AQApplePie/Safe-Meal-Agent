# Copy to .env. Values below are development defaults, not production secrets.
APP_ENV=development
DEBUG=false
API_KEY=safemeal-local-api-key
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads

# DashScope/OpenAI-compatible model, embedding and rerank APIs.
ENABLE_LLM=true
LLM_MODEL=qwen3-max
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_REQUEST_TIMEOUT=90
LLM_MAX_RETRIES=2
LLM_STRUCTURED_REPAIR_RETRIES=1

ENABLE_EMBEDDINGS=true
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_DIMENSION=1024

RERANK_ENABLED=true
RERANK_MODEL=qwen3-rerank
RERANK_API_KEY=
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services
RERANK_ENDPOINT=/rerank/text-rerank/text-rerank

# Local services. Docker Compose overrides hosts inside the API container.
DATABASE_URL=mysql+pymysql://recipe_user:safemeal-local@127.0.0.1:13306/recipe_db
DB_CONNECT_TIMEOUT=10
MYSQL_DATABASE=recipe_db
MYSQL_USER=recipe_user
MYSQL_PASSWORD=safemeal-local
MYSQL_ROOT_PASSWORD=safemeal-local-root

REDIS_RATE_LIMIT_URL=redis://127.0.0.1:16379/0
HTTP_RATE_LIMIT_PER_MINUTE=120

ENABLE_MILVUS=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION=recipes_current
KB_TOP_K=5
KB_MAX_CHUNKS_PER_DOCUMENT=2
KB_DOCUMENT_RECALL_MULTIPLIER=4

ENABLE_NEO4J=true
NEO4J_URI=bolt://127.0.0.1:17687
NEO4J_USER=neo4j
NEO4J_PASSWORD=safemeal-local-neo4j
NEO4J_AUTH=neo4j/safemeal-local-neo4j
NEO4J_DATABASE=neo4j
NEO4J_RECIPE_JSON_PATH=data/recipe.json
NEO4J_INGREDIENT_JSON_PATH=data/neo4j/excipients.json

# Agent: local semaphore plus stable JSONL Trace.
AGENT_MAX_CONCURRENCY=8
AGENT_TIMEOUT=300
AGENT_MAX_TOOL_CALLS=12
AGENT_CONTEXT_TOKEN_BUDGET=6000
AGENT_RESPONSE_TOKEN_RESERVE=1200
ENABLE_AGENT_TRACE_PERSISTENCE=true
AGENT_TRACE_PATH=data/runtime/agent_traces.jsonl

# Milvus dependencies used by Docker Compose.
MINIO_ROOT_USER=safemealminio
MINIO_ROOT_PASSWORD=safemeal-local-minio
