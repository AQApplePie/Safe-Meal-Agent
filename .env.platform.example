# Standalone platform only. Copy to .env.platform for local Python startup.
APP_ENV=development
DATABASE_URL=mysql+pymysql://recipe_user:safemeal-local@127.0.0.1:23306/recipe_db
AUTH_JWT_SECRET=development-only-change-me
CORS_ORIGINS=http://localhost:5173
REDIS_RATE_LIMIT_URL=redis://127.0.0.1:26379/0
RECIPE_CACHE_URL=redis://127.0.0.1:26379/1
RECIPE_RANKING_REDIS_URL=redis://127.0.0.1:26379/2
BEHAVIOR_EVENT_REDIS_URL=redis://127.0.0.1:26379/3
DB_CONNECT_TIMEOUT=3
DB_LOCK_WAIT_TIMEOUT_SECONDS=2
DB_TRANSACTION_MAX_ATTEMPTS=3
# Docker host ports; different from the Agent Compose defaults.
PLATFORM_API_PORT=8100
PLATFORM_MYSQL_PORT=23306
PLATFORM_REDIS_PORT=26379

# Local metrics demo; replace token before production.
METRICS_ENABLED=true
METRICS_TOKEN=development-metrics-token-change-me
METRICS_OUTBOX_SCRAPE_SECONDS=5
