{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat", "title": "Agent runs / 5m", "id": 1,
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "safemeal-prometheus"},
      "targets": [{"expr": "sum(increase(safemeal_agent_runs_total[5m]))", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Error rate", "id": 2,
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "datasource": {"type": "prometheus", "uid": "safemeal-prometheus"},
      "targets": [{"expr": "sum(rate(safemeal_agent_runs_total{status=\"error\"}[5m])) / clamp_min(sum(rate(safemeal_agent_runs_total[5m])), 0.001)", "refId": "A"}]
    },
    {
      "type": "stat", "title": "P95 latency", "id": 3,
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "datasource": {"type": "prometheus", "uid": "safemeal-prometheus"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(safemeal_agent_run_duration_seconds_bucket[5m])))", "refId": "A"}]
    },
    {
      "type": "stat", "title": "Feedback positive rate", "id": 4,
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "fieldConfig": {"defaults": {"unit": "percentunit"}, "overrides": []},
      "datasource": {"type": "prometheus", "uid": "safemeal-prometheus"},
      "targets": [{"expr": "sum(safemeal_answer_feedback_total{rating=\"positive\",outcome=\"accepted\"}) / clamp_min(sum(safemeal_answer_feedback_total{outcome=\"accepted\"}), 1)", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Model calls", "id": 5,
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "safemeal-prometheus"},
      "targets": [{"expr": "sum by (model, status) (rate(safemeal_model_calls_total[5m]))", "legendFormat": "{{model}} / {{status}}", "refId": "A"}]
    },
    {
      "type": "timeseries", "title": "Tool calls", "id": 6,
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "safemeal-prometheus"},
      "targets": [{"expr": "sum by (tool, status) (rate(safemeal_tool_calls_total[5m]))", "legendFormat": "{{tool}} / {{status}}", "refId": "A"}]
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["safemeal", "agent"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "SafeMeal Agent Overview",
  "uid": "safemeal-agent-overview",
  "version": 1
}
